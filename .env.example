# Copy to .env and fill in. .env is gitignored.

# Postgres. Local: from docker-compose. Prod: Render → farmermarket-postgres → connection string.
DATABASE_URL=postgres://farmermarket:farmermarket@localhost:5432/farmermarket

# Redis (worker / rate-limiting). Local: from docker-compose.
REDIS_URL=redis://localhost:6379

# JWT signing secret for staff + buyer tokens.
JWT_SECRET=dev-only-change-me

# Cloudinary — media storage for catalog images.
# Dashboard → Product Environment Credentials → "API environment variable".
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Comma-separated allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000
