# Portability rule #1 (§4.4): every service runs in Docker so the AWS move
# is "push this image to ECR," not a rewrite.
FROM node:20-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/core/package.json packages/core/package.json
RUN pnpm install --frozen-lockfile --filter @farmermarket/api...

FROM deps AS build
COPY . .
# @farmermarket/db and @farmermarket/core ship a real `dist/`, not raw .ts —
# a plain `node dist/main.js` can require() compiled JS, but not a workspace
# dependency's TypeScript source (Next.js can, via its bundler; this can't).
# `--filter @farmermarket/api...` builds api plus everything it depends on,
# in dependency order, so this one command covers all three packages.
RUN pnpm --filter @farmermarket/api... run build
# @farmermarket/db's workspace symlink otherwise points at ../../packages/db,
# which doesn't exist once only this stage's output is copied into the
# runner stage. `pnpm deploy` resolves workspace deps into real files inside
# the target dir instead, making it copyable on its own.
RUN pnpm --filter=@farmermarket/api --prod deploy /app/deploy

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app/deploy
# Deploying to the same absolute path in both stages, rather than renaming
# it on the way in, protects against pnpm's deployed node_modules using
# absolute (not relative) symlinks internally — same path in, same path out.
COPY --from=build /app/deploy /app/deploy
EXPOSE 3001
CMD ["node", "dist/main.js"]
