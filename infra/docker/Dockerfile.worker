FROM node:20-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm install --frozen-lockfile --filter @farmermarket/worker...

FROM deps AS build
COPY . .
# See Dockerfile.api's comments — @farmermarket/db needs its own real build,
# and `pnpm deploy` resolves it into real files instead of a dangling
# workspace symlink.
RUN pnpm --filter @farmermarket/worker... run build
RUN pnpm --filter=@farmermarket/worker --prod deploy /app/deploy

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app/deploy
COPY --from=build /app/deploy /app/deploy
CMD ["node", "dist/index.js"]
