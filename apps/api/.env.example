DATABASE_URL=postgres://farmermarket:farmermarket@localhost:5432/farmermarket
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-every-real-environment
PORT=3001
CORS_ORIGINS=http://localhost:3000

# The API applies pending drizzle migrations on boot and refuses to start if
# one fails (so a deploy can't serve new code against an old schema). Set to
# "false" to manage migrations out-of-band instead.
# RUN_MIGRATIONS_ON_BOOT=false

# Cloudinary — required for KYC document upload (POST /v1/kyc/documents).
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>

# Resend — transactional email. If unset, EmailService logs a dry-run line.
# EMAIL_FROM's domain must be verified in Resend. EMAIL_REPLY_TO is where
# customer replies land (defaults to admin@farmermarket.ng if unset).
RESEND_API_KEY=
EMAIL_FROM=Farmer Market <noreply@farmermarket.ng>
EMAIL_REPLY_TO=admin@farmermarket.ng

# Termii — SMS for Sign Up phone verification (POST /v1/auth/customer/otp/*).
# If TERMII_API_KEY is unset, SMS runs in dry-run mode: the code is logged
# to the server, not sent, so local Sign Up still works end-to-end.
# TERMII_SENDER_ID must be an approved sender ID on the Termii account
# (an unapproved one is rejected at send time). TERMII_CHANNEL "dnd" is
# required to reach numbers on the Nigerian Do-Not-Disturb list.
TERMII_API_KEY=
TERMII_SENDER_ID=Demeterra
TERMII_CHANNEL=dnd
# TERMII_BASE_URL=https://api.ng.termii.com   # override only for a sandbox
# OTP_DEV_ECHO=1  — returns the verification code in the /otp/request
# response (only when no SMS was actually sent). For walking the Sign Up
# wizard before an SMS sender is live. Remove it once SMS works.

# Inbox — reads/replies to admin@farmermarket.ng inside the dashboard
# (POST /v1/inbox/sync, GET/POST /v1/admin/inbox/*). IMAP for receiving,
# SMTP for sending; most hosts use the same user/password for both. Unset
# INBOX_IMAP_HOST ⇒ the inbox stays empty and replies return 503.
INBOX_IMAP_HOST=
INBOX_IMAP_PORT=993
INBOX_SMTP_HOST=
INBOX_SMTP_PORT=465
INBOX_EMAIL_USER=admin@farmermarket.ng
INBOX_EMAIL_PASSWORD=
INBOX_EMAIL_FROM=Farmer Market <admin@farmermarket.ng>

# Shared secret for every machine-triggered endpoint — the daily collections
# run (POST /v1/collections/cron) and the inbox sync (POST /v1/inbox/sync),
# both called by their own .github/workflows/*.yml. Must match the GitHub
# repo secret COLLECTIONS_CRON_SECRET. Unset ⇒ both endpoints return 503
# (closed, not open). The dashboard "Run reminders" button doesn't use this
# — it's staff-JWT.
COLLECTIONS_CRON_SECRET=

# Populated in later phases (§9) — fake adapters until credentials land.
FIRSTCENTRAL_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=farmermarket-media-prod
S3_DOCUMENTS_BUCKET=farmermarket-documents-prod

# -- Mono ----------------------------------------------------------------
# Two separate Mono products, two separate keys. Both are SECRET keys and
# both travel in the `mono-sec-key` header -- never send either to a
# browser. The publishable key (test_pk_/live_pk_) belongs in the web app
# as NEXT_PUBLIC_MONO_PUBLIC_KEY, and only Connect needs one.

# 1. CONNECT -- account linking, transactions, income (§9.1).
#    Consumed by MonoModule. Unset => FakeMonoClient (canned salary data).
#    This one is wired up and working.
MONO_SECRET_KEY=

# 2. LOOKUP -- BVN / NIN / CAC identity verification.
#    NOT YET CONSUMED BY ANY CODE. There is no lookup client under
#    apps/api/src/modules/integrations/ -- paste the key here and nothing
#    will read it until that module exists. Kept separate from the Connect
#    key because the two products are separate apps in the Mono dashboard;
#    if yours share a single key, put the same value in both slots.
MONO_LOOKUP_SECRET_KEY=

# Webhook auth for POST /v1/webhooks/mono. Must match the value set in the
# Mono dashboard under that app's Webhooks.
MONO_WEBHOOK_SECRET=

# Only needed for a non-default sandbox host.
# MONO_BASE_URL=https://api.withmono.com
