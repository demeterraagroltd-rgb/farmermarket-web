NEXT_PUBLIC_API_URL=http://localhost:3001

# Mono Connect — the PUBLISHABLE key (starts with `test_pk_` / `live_pk_`),
# safe to ship in the browser bundle. The secret key belongs to the API only.
# Unset ⇒ the "Link your salary account" button renders a
# "not configured on this environment" note instead of the widget.
NEXT_PUBLIC_MONO_PUBLIC_KEY=
